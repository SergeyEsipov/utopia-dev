# Copy to .env.local and fill in. Both variables are optional in development.

# Absolute origin of the deployed site. Required in production for canonical
# URLs and OG tags — without it no canonical is emitted at all (see src/lib/site.ts).
NEXT_PUBLIC_SITE_URL=https://example.com

# Revolut People (ATS) tenant slug — the <your-company-name> in
# https://<your-company-name>.revolutpeople.com. Defaults to utopia-hq-ltd.
REVOLUT_PEOPLE_COMPANY=utopia-hq-ltd

# Corner-language variant the site ships with while the client chooses between
# the designers' two builds:
#   rounded → prototype desktop_v8 (default)
#   sharp   → prototype desktop_v9
# Any visitor can override per session with ?variant=rounded / ?variant=sharp,
# so this only sets what an untouched first load looks like.
NEXT_PUBLIC_SITE_VARIANT=rounded
